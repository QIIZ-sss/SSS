# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง — ห้าม commit ไฟล์ .env เข้า git เด็ดขาด
PORT=3001
NODE_ENV=development

# สร้างค่าสองตัวนี้แยกกัน อย่าใช้ค่าเดียวกัน
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=เปลี่ยนค่านี้ก่อนขึ้นเซิร์ฟเวอร์จริง
ADMIN_JWT_SECRET=เปลี่ยนค่านี้ด้วย_และต้องไม่ซ้ำกับด้านบน
SESSION_TTL=4h
ADMIN_SESSION_TTL=8h

# ฐานข้อมูล — ปิดไว้เป็นค่าเริ่มต้น เกมเล่นได้เลยโดยไม่ต้องติดตั้ง PostgreSQL
# เอา # ออกเมื่อยกฐานข้อมูลขึ้นแล้ว (docker compose up -d) เพื่อเปิดการบันทึกและหน้าหลังบ้าน
# DATABASE_URL=postgres://wadtor:wadtor@localhost:5432/wadtor
DB_SSL=false

# โดเมนของหน้าเว็บ คั่นด้วยจุลภาค ห้ามใช้ * บนเครื่องจริง
CORS_ORIGINS=http://localhost:5173

# ขีดจำกัดห้อง
MAX_PLAYERS_PUBLIC=10
MAX_PLAYERS_PRIVATE=25

# ขีดจำกัดข้อมูลภาพวาด (กัน payload ระเบิด)
MAX_STROKES_PER_SUBMIT=300
MAX_POINTS_PER_SUBMIT=5000
